# ---------------------------------------------------------------
# Copy this file to ".env" (same folder) and fill in your Gmail.
# Then every sign-up / transfer sends a REAL email to the user's inbox.
# Leave .env out completely and emails go to the fake inbox at http://localhost:8025
# ---------------------------------------------------------------

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true

# The Gmail address the emails are sent FROM
MAIL_USERNAME=yourname@gmail.com

# NOT your normal Gmail password. A 16-letter "App Password":
# Google Account -> Security -> 2-Step Verification (turn on) -> App passwords -> create one -> paste it here (no spaces)
MAIL_PASSWORD=abcdefghijklmnop
